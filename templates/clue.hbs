<section class="{{cssClass}}" autocomplete="off">
  <div class="clue-actor-name">
    <label for="name">{{localize "sofh.ui.clue.name"}}</label>
    <input id="name" name="name" type="text" value="{{actor.name}}" />

  </div>
  <nav class="sheet-tabs tabs clue" data-group="primary">
    <a
      class="party-list"
      data-group="primary"
      data-action="tab"
      data-tab="party_list"
    >{{localize "sofh.ui.clue.party_list"}}</a>
    <a
      class="clue-list"
      data-group="primary"
      data-action="tab"
      data-tab="clue_list"
    >{{localize "sofh.ui.clue.clue_table"}}</a>
    {{#if (checkSolution)}}
      <a
        class="mistery-solve-list"
        data-group="primary"
        data-action="tab"
        data-tab="solve_list"
      >{{localize "sofh.ui.clue.solution_table"}}</a>
    {{/if}}
  </nav>

</section>