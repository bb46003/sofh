<section
  class="tab equipment flexcol {{tabs.equipment.cssClass}}"
  data-action="tab"
  data-group="primary"
  data-tab="equipment"
>

  <div class="eq-sheet">
    <div class="note-sheet">
      <h2>{{localize "sofh.ui.actor.notes"}}</h2>
      <div class="note-tab" data-group="primary" data-tab="note">

            {{formInput
      notes.field
      value=notes.value
      enriched=notes.enriched
      toggled="true"
    }}
      </div>
    </div>
    <h2>{{localize "sofh.ui.actor.baseshooleq"}}</h2>
    <div class="eq-tab" data-group="primary" data-tab="equipment">

                  {{formInput
      equipment.field
      value=equipment.value
      enriched=equipment.enriched
      toggled="true"
    }}
    </div>
    <h2>{{localize "sofh.ui.actor.pesonaleq"}}</h2>
    <div class="eq-tab" data-group="primary" data-tab="equipment">

                  {{formInput
      equipmentpersonal.field
      value=equipmentpersonal.value
      enriched=equipmentpersonal.enriched
      toggled="true"
    }}
    </div>
  </div>
</section>