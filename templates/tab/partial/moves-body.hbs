<div class="move-elements">
  <div class="trigers-sheet">
    <h4 class="move_type trigger-label">{{localize
        "sofh.item.trigerlabel"
      }}</h4>
    {{formInput
      triggers.field
      value=triggers.value
      enriched=triggers.enriched
      toggled="true"
    }}
  </div>
  <div class="description-sheet">
    <h4 class="move_type description-label">{{localize
        "sofh.item.descriptionlabel"
      }}</h4>
    {{formInput
      description.field
      value=description.value
      enriched=description.enriched
      toggled="true"
    }}
  </div>
</div>
{{#if (eq system.havequestion true)}}
  <div class="moves-question">
    {{> "systems/SofH/templates/tab/partial/moves-question.hbs"}}
  </div>
{{/if}}
{{#if (eq system.realtedtoothermoves true)}}
  <div class="moves-realtedtoothermoves">
    <h4 class="move_type description-label">{{localize
        "sofh.item.realtedtoothermoves"
      }}</h4>
    {{formInput
      relatedmoves.field
      value=relatedmoves.value
      enriched=relatedmoves.enriched
      toggled="true"
    }}
  </div>
{{/if}}
{{#if (eq system.isrolled true)}}
  <h4 class="move_type description-label">{{localize "sofh.item.isrolled"}}</h4>
  <div class="moves-isrolled">

    {{#if (eq system.result12 true)}}
      <div class="row">
        <label for="above10">{{localize "sofh.ui.move.resultAbove12"}}</label>
        {{formInput
          above12.field
          value=above12.value
          enriched=above12.enriched
          toggled="true"
        }}
      </div>
    {{/if}}
    <div class="row">
      <label for="above10">{{localize "sofh.ui.move.resultAbove10"}}</label>
      {{formInput
        above10.field
        value=above10.value
        enriched=above10.enriched
        toggled="true"
      }}
    </div>
    <div class="row">
      <label for="7to9">{{localize "sofh.ui.move.result7to9"}}</label>
      {{formInput
        [7to9].field
        value=[7to9].value
        enriched=[7to9].enriched
        toggled="true"
      }}
    </div>

    <div class="row">
      <label for="below7">{{localize "sofh.ui.move.resultBelow7"}}</label>
      {{formInput
        below7.field
        value=below7.value
        enriched=below7.enriched
        toggled="true"
      }}
    </div>

  </div>
{{/if}}
<div class="designer-comment">
  <h4 class="move_type trigger-label">{{localize
      "sofh.item.designerComment"
    }}</h4>
  {{formInput
    designer-comment.field
    value=designer-comment.value
    enriched=designer-comment.enriched
    toggled="true"
  }}
</div>