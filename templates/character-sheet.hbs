<section class="main-sheet">
    <div class="title-section">
      <div class="main-info">
        <img class="borderless" src="{{actor.img}}" data-edit="img">
        <div class="form-grid">
          <div class="stat-grid">
            <label for="name">{{localize "sofh.ui.actor.name"}}</label>
            <input id="name" name="name" type="text" value="{{actor.name}}">
          </div>
          <div class="stat-grid">
            <label for="home">{{localize "sofh.ui.actor.house"}}</label>
            <select name="system.home" class="house">
              <option value="">None</option>
                {{selectOptions House selected=system.home localize=true}}
            </select>
          </div>
          <div class="stat-grid">
            <label for="year">{{localize "sofh.ui.actor.years"}}</label>
            {{#if actor.system.changedYear}}
              <div class="flex">
                <input id="schoolyear"  name="system.schoolyear.value" type="number" value="{{system.schoolyear.value}}" min="1" max="7" step="1">
                <a id="reputationQuestions">{{localize "sofh.ui.actor.reputation_questions"}}</a>
              </div> 
            {{else}}
              <input id="schoolyear"  name="system.schoolyear.value" type="number" value="{{system.schoolyear.value}}" min="1" max="7" step="1">    
            {{/if}}            
          </div>
          <div class="stat-grid"></div>
            <label for="house-question" class="hover-label-question">{{localize "sofh.ui.house-questionlabel"}}</label>
            <textarea class="house-question" name="system.housequestion" type="text" value="{{system.housequestion}}" disabled>{{system.housequestion}}</textarea>

          </div>
        
        <div class="empty-column">
           {{#if (eq system.house (lowercase (localize "sofh.ui.actor.gryffindor")))}}
              <img class="home-flag" src="systems/SofH/img/gryfbanner.png">  
            {{/if}}
            {{#if (eq system.house (lowercase (localize "sofh.ui.actor.hufflepuff")))}}
              <img class="home-flag" src="systems/SofH/img/huffbanner.png">
            {{/if}}
            {{#if (eq system.house (lowercase (localize "sofh.ui.actor.ravenclaw")))}}
              <img class="home-flag" src="systems/SofH/img/ravebanner.png">  
            {{/if}}
            {{#if (eq system.house (lowercase (localize "sofh.ui.actor.slytherin")))}}
              <img class="home-flag" src="systems/SofH/img/slybanner.png">   
            {{/if}}        
        </div> 
        </div>
      </div>
    </div>

    <nav class="sheet-tabs tabs" data-group="primary">
      <a class="characteristic" data-group="primary" data-action="tab" data-tab="characteristic">{{localize "sofh.ui.actor.characteristic"}}</a>
      <a class="relations"  data-group="primary" data-action="tab" data-tab="relations">{{localize "sofh.ui.actor.relationships"}}</a>
      <a class="strings"  data-group="primary" data-action="tab" data-tab="strings">{{localize "sofh.ui.actor.strings"}}</a>
      <a class="moves"  data-group="primary" data-action="tab" data-tab="moves">{{localize "sofh.ui.actor.moves"}}</a>
      <a class="equipment"  data-group="primary" data-action="tab" data-tab="equipment">{{localize "sofh.ui.actor.eq"}}</a>    
    </nav>

</section>
